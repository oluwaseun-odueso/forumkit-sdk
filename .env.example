# ── Database ──────────────────────────────────────────────────────
# Direct connection — migrations only (port 5432)
DATABASE_URL=postgresql://postgres:password@localhost:5432/forumkit

# Pooled connection — application runtime (port 6543 on Supabase)
DATABASE_POOL_URL=postgresql://postgres:password@localhost:5432/forumkit

# ── Auth ──────────────────────────────────────────────────────────
# Shared secret used to verify JWTs signed by the host application
FORUM_SECRET_KEY=change-this-to-a-long-random-string

# ── AI providers (all optional — local fallbacks used if absent) ──
AI_PROVIDER=local              # local | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

MODERATION_PROVIDER=local      # local | perspective
PERSPECTIVE_API_KEY=

EMBEDDING_PROVIDER=local       # local | openai
# Must match the provider: 384 for local all-MiniLM, 1536 for OpenAI
# Set this BEFORE running migrations — do not change on an existing database
EMBEDDING_DIMENSION=384

# ── Storage (image/video uploads) — REQUIRED, no local fallback ────
# Every integrator must provide their own S3-compatible bucket:
# AWS S3, Cloudflare R2, MinIO, Backblaze B2, or Supabase Storage all
# work through this one config. Leave STORAGE_S3_ENDPOINT unset for
# real AWS S3; set it for any other S3-compatible provider.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

STORAGE_MAX_FILE_SIZE_BYTES=26214400   # 25MB
STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm

# ── GIF search (optional — comment composer's GIF picker) ─────────
# Get a key at developers.giphy.com. Left blank, the GIF picker stays
# a disabled "coming soon" panel instead of erroring.
GIPHY_API_KEY=

# ── App ───────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info                 # error | warn | info | debug
NODE_ENV=development           # development | production
SESSION_TTL_MINUTES=15
MAX_POST_LENGTH=10000
